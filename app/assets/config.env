# BlueChip Rewards — runtime configuration.
# These values are safe to ship in the client: the Supabase anon key is public
# and protected by Row Level Security. NEVER put the service-role key here.
# Replace the placeholders with your project's values (or override at build time
# with --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...).
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
# Android web client ID from Google Cloud (OAuth 2.0) for native Google Sign-In.
GOOGLE_WEB_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
# AdMob rewarded ad unit (test unit shipped as a safe default).
ADMOB_REWARDED_AD_UNIT=ca-app-pub-3940256099942544/5224354917
# AppLovin MAX SDK key / Unity Ads Game ID. Leave EMPTY to keep those networks
# off (placements set to them fall back to AdMob test ads). These are account
# keys, not production ad-unit ids.
APPLOVIN_SDK_KEY=
UNITY_GAME_ID=
